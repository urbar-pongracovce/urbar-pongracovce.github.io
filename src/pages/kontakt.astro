---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// Pongrácovce: 49.0195 N, 20.8229 E
const bbox = '20.795,49.005,20.851,49.034';
const marker = '49.0195,20.8229';
---

<Base
  title="Kontakt"
  description="Kontakt na Urbársku spoločnosť pozemkové spoločenstvo Pongrácovce — adresa, e-mail a mapa."
>
  <PageHero
    title="Kontakt"
    subtitle="Máte otázku k podielom, dedičstvu alebo hospodáreniu? Napíšte nám alebo nás navštívte."
  />

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:py-20">
    <div class="space-y-6">
      <div class="reveal rounded-3xl border border-cream-200 bg-white p-8 shadow-sm">
        <h2 class="font-display mb-6 text-2xl font-semibold text-forest-900">Napíšte nám</h2>
        <div class="space-y-5 text-forest-800">
          <a
            href="mailto:urbariat.pongracovce@proton.me"
            class="group flex items-center gap-4"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-forest-100 text-forest-700">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                />
              </svg>
            </span>
            <span>
              <span class="block text-xs font-semibold tracking-wide text-forest-500 uppercase">E-mail</span>
              <span class="font-medium group-hover:text-gold-600">urbariat.pongracovce@proton.me</span>
            </span>
          </a>

          <div class="flex items-center gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-forest-100 text-forest-700">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                />
              </svg>
            </span>
            <address class="not-italic">
              <span class="block text-xs font-semibold tracking-wide text-forest-500 uppercase">Sídlo</span>
              <span class="font-medium">Pongrácovce 30, 053 05 Pongrácovce</span>
            </address>
          </div>

          <div class="flex items-center gap-4">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-forest-100 text-forest-700">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25M9 12.75h6m-6 3h3M5.625 1.5H9a3.75 3.75 0 0 1 3.75 3.75v1.875c0 .621.504 1.125 1.125 1.125H15.75a3.75 3.75 0 0 1 3.75 3.75v9.375c0 .621-.504 1.125-1.125 1.125H5.625a1.125 1.125 0 0 1-1.125-1.125V2.625c0-.621.504-1.125 1.125-1.125Z"
                />
              </svg>
            </span>
            <div>
              <span class="block text-xs font-semibold tracking-wide text-forest-500 uppercase">Fakturačné údaje</span>
              <span class="font-medium">IČO: 56940980 · DIČ: 2122505627</span>
            </div>
          </div>
        </div>

        <a
          href="mailto:urbariat.pongracovce@proton.me?subject=Otázka%20pre%20urbár%20Pongrácovce"
          class="mt-8 inline-block rounded-full bg-forest-800 px-7 py-3 text-sm font-semibold tracking-wide text-cream-50 uppercase transition hover:bg-forest-700"
        >
          Napísať e-mail
        </a>
      </div>

      <div class="reveal rounded-3xl border border-cream-200 bg-white p-8 shadow-sm text-sm leading-relaxed text-forest-700">
        <h2 class="font-display mb-3 text-xl font-semibold text-forest-900">Úradné hodiny</h2>
        <p>
          Osobné stretnutie s predsedom alebo členmi výboru si prosím dohodnite vopred
          e-mailom. Aktuálne informácie o zhromaždeniach nájdete
          v&nbsp;<a href="/oznamy/" class="font-semibold text-forest-600 underline underline-offset-4 hover:text-gold-600">oznamoch</a>.
        </p>
      </div>
    </div>

    <div class="reveal overflow-hidden rounded-3xl border border-cream-200 shadow-sm">
      <iframe
        title="Mapa — Pongrácovce"
        class="h-full min-h-[420px] w-full"
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${marker}`}
        loading="lazy"
      ></iframe>
    </div>

    <div
      class="reveal relative overflow-hidden rounded-3xl bg-forest-950 p-8 text-cream-100 shadow-sm sm:p-10 lg:col-span-2"
    >
      <div
        class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-gold-400/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative grid items-center gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <p class="mb-2 text-xs font-semibold tracking-[0.2em] text-gold-400 uppercase">
            Tvorca webu
          </p>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">
            Páči sa vám táto stránka?
          </h2>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed opacity-85">
            Web vytvorila spoločnosť <strong>AGROBERIT s.&nbsp;r.&nbsp;o.</strong> — tvoríme moderné
            webové stránky pre urbariáty, pozemkové spoločenstvá, obce a firmy a vyvíjame softvér
            pre lesníctvo, napríklad
            <a
              href="https://kubikovac.github.io/"
              target="_blank"
              rel="sponsored noopener"
              class="font-semibold text-gold-400 underline underline-offset-4 hover:text-gold-500"
              >Kubikovač guľatiny</a
            >
            na výpočet objemu dreva kompatibilný s STN&nbsp;48&nbsp;0009.
          </p>
          <p class="mt-3 text-xs opacity-60">AGROBERIT s. r. o. · IČO 57 163 171</p>
        </div>
        <a
          href="mailto:agroberit@gmail.com?subject=M%C3%A1m%20z%C3%A1ujem%20o%20webov%C3%BA%20str%C3%A1nku"
          class="inline-block rounded-full bg-gold-500 px-7 py-3 text-center text-sm font-semibold tracking-wide text-forest-950 uppercase transition hover:bg-gold-400"
        >
          Chcem podobný web
        </a>
      </div>
    </div>
  </section>
</Base>
