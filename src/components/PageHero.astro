---
// Tmavý úvodný pás podstránky — drží kontrast s priesvitnou hlavičkou
import { Image } from 'astro:assets';

interface Props {
  title: string;
  subtitle?: string;
  obrazok?: ImageMetadata;
}
const { title, subtitle, obrazok } = Astro.props;
---

<section class="relative overflow-hidden bg-forest-950 pt-32 pb-16 text-cream-50 sm:pt-40 sm:pb-20">
  {
    obrazok ? (
      <>
        <Image
          src={obrazok}
          alt=""
          class="absolute inset-0 h-full w-full object-cover"
          widths={[768, 1280, 2000, 3200]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-forest-950/70 via-forest-950/40 to-forest-950/70" />
      </>
    ) : (
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.06]"
        style="background-image: radial-gradient(circle at 20% 20%, #d3b165 0, transparent 40%), radial-gradient(circle at 80% 70%, #4d7659 0, transparent 45%);"
      />
    )
  }
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <p class="mb-3 text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase [text-shadow:0_1px_8px_rgba(6,18,11,0.8)]">
      Urbár Pongrácovce
    </p>
    <h1 class="font-display max-w-3xl text-4xl font-semibold text-balance sm:text-5xl [text-shadow:0_2px_14px_rgba(6,18,11,0.7)]">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg leading-relaxed opacity-90 [text-shadow:0_1px_10px_rgba(6,18,11,0.7)]">{subtitle}</p>}
  </div>
</section>
