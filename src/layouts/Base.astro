---
import '@fontsource-variable/inter';
import '@fontsource-variable/playfair-display';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Urbárska spoločnosť pozemkové spoločenstvo Pongrácovce — urbariát obce Pongrácovce. Spravujeme spoločné lesy a pasienky v katastri obce, okres Levoča, Spiš.',
} = Astro.props;

const fullTitle =
  title === 'Domov'
    ? 'Urbár Pongrácovce — Urbárska spoločnosť pozemkové spoločenstvo Pongrácovce'
    : `${title} · Urbár Pongrácovce`;

const webSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Urbár Pongrácovce',
  alternateName: [
    'Urbárska spoločnosť pozemkové spoločenstvo Pongrácovce',
    'Urbariát Pongrácovce',
  ],
  url: new URL('/', Astro.site).href,
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Urbárska spoločnosť pozemkové spoločenstvo Pongrácovce',
  alternateName: 'Urbár Pongrácovce',
  url: new URL('/', Astro.site).href,
  logo: new URL('favicon-512.png', Astro.site).href,
  image: new URL('og.jpg', Astro.site).href,
  email: 'urbariat.pongracovce@proton.me',
  telephone: '+421918069987',
  foundingDate: '2025-04-23',
  identifier: [{ '@type': 'PropertyValue', propertyID: 'IČO', value: '56940980' }],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Pongrácovce 30',
    addressLocality: 'Pongrácovce',
    postalCode: '053 05',
    addressCountry: 'SK',
  },
};
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1d15" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Oznamy — Urbár Pongrácovce"
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Urbár Pongrácovce" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:image" content={new URL('og.jpg', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "b6f8e8a5b1734b6a9d26c43b190e926b"}'></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
